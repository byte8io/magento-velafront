{
    "name": "byte8/module-velafront",
    "description": "Byte8 VelaFront - Magento 2 companion module for the VelaFront headless storefront. Exposes Page Builder content as structured JSON via GraphQL.",
    "type": "magento2-module",
    "license": [
        "proprietary"
    ],
    "authors": [
        {
            "name": "Byte8 Ltd",
            "email": "support@byte8.io"
        }
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-json": "*",
        "magento/framework": "*",
        "magento/module-catalog": "*",
        "magento/module-cms": "*",
        "magento/module-store": "*",
        "magento/module-catalog-graph-ql": "*",
        "magento/module-cms-graph-ql": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Byte8\\VelaFront\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    }
}
